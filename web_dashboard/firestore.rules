rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /waypoints/{document=**} {
      allow read: if true; 
      allow write: if true;
    }
    
     match /devices/{document=**} {
      allow read: if true; 
      allow write: if true;
    }
      
      match /wearable_data/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
      
      match /report_data/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
      
      match /wearable_data2/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
      
      match /wearable_data3/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
      
      match /wearable_data_500/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
      
    	match /cloud_function/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
      
      match /aggregated_data/{document=**} {
      allow read: if true; 
      allow write: if true;
      }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read;
    }
  }
}


